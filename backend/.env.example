# Copy to backend/.env and fill in. Never commit the real .env.
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_swe_agent
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# LLM (Architecture + Development agents). Without a key, planning fails honestly with "MISTRAL_API_KEY is not configured".
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# QA runner: "docker" (default, hardened container, needs Docker socket) or "local" (dev/test only; runs repo commands on the API host)
QA_RUNNER=docker

# Remote merge/pull request creation (optional). Without a token the MR is a LOCAL review record and says so.
GIT_PROVIDER_TOKEN=
GIT_PROVIDER_KIND=auto
GITHUB_API_URL=https://api.github.com
GITLAB_API_URL=https://gitlab.com/api/v4

# Deployment (optional). Operator-controlled command run in the extracted release directory after MR approval.
# Unset => deployment reports DEPLOYMENT_UNAVAILABLE (never "deployed").
DEPLOY_COMMAND=
DEPLOY_HEALTHCHECK_URL=
