#!/bin/sh
set -eu
if [ -S /var/run/docker.sock ]; then
  gid="$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0)"
  if [ "$gid" != "0" ]; then
    if ! getent group rad-docker >/dev/null 2>&1; then groupadd -g "$gid" rad-docker 2>/dev/null || true; fi
    usermod -aG "$gid" appuser 2>/dev/null || usermod -aG rad-docker appuser 2>/dev/null || true
  fi
fi
chown -R appuser:appuser /workspaces /milvus-data 2>/dev/null || true
exec su -s /bin/sh appuser -c 'exec "$@"' -- appuser "$@"
